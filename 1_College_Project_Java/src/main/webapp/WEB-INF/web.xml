<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Cloud GA Scheduler</display-name>
    <description>Cloud Resource Allocation using Genetic Algorithm</description>

    <!-- GA Servlet Mapping -->
    <servlet>
        <servlet-name>GAServlet</servlet-name>
        <servlet-class>com.cloud.allocation.web.GAServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>GAServlet</servlet-name>
        <url-pattern>/ga</url-pattern>
    </servlet-mapping>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
